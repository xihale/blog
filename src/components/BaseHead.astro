---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
import FontLoader from "./FontLoader.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import avatarImg from "../assets/images/avatar.jpg";
import faviconImg from "../assets/images/favicon.jpg";

interface Props {
  title: string;
  description: string;
  robots?: string;
  /** Per-page cover: site-root path under public/, absolute URL, or an imported image. */
  cover?: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, robots, cover } = Astro.props;

const favicon = await getImage({ src: faviconImg, format: "jpg" });
const ogImageUrl = cover
  ? typeof cover === "string"
    ? new URL(cover, Astro.site).toString()
    : new URL(
        (await getImage({ src: cover, format: "jpg", width: 1200, height: 630 })).src,
        Astro.url,
      ).toString()
  : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fffffd" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#17191d" media="(prefers-color-scheme: dark)" />
{robots && <meta name="robots" content={robots} />}
<link rel="icon" type="image/jpeg" href={favicon.src} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/atom+xml"
  title={SITE_TITLE}
  href={new URL("atom.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<FontLoader />

<!-- Page-specific Metadata -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

<!-- Twitter -->
<meta property="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{ogImageUrl && <meta property="twitter:image" content={ogImageUrl} />}

<script is:inline>
  // Firefox (144+, Zen included) paints 1-2 blank frames between the old and
  // new snapshots of a same-document view transition; Chrome does not, so
  // every ClientRouter navigation flashes there. Dropping the API makes Astro
  // take its fallback="swap" path: a direct DOM swap, which is also what this
  // site's animation: none view-transition CSS intends. Must stay an inline
  // classic script: module scripts are deferred, and Astro's router reads
  // document.startViewTransition when its module first evaluates.
  if (navigator.userAgent.includes("Firefox")) {
    document.startViewTransition = undefined;
  }
</script>

<script is:inline>
  // Astro's ClientRouter sets history.scrollRestoration = "manual" and only
  // re-applies the saved scroll position when its deferred router module
  // evaluates. On a reload the browser therefore paints the top of the page
  // first and visibly teleports to the old position once the router catches
  // up (slow devices paint faster than module scripts run). We restore
  // earlier ourselves: hide the body until the saved position can actually
  // be applied (scrollHeight must be tall enough, or we hit a cap), then
  // reveal — the first paint the user sees is already at the right offset.
  (() => {
    try {
      const nav = performance.getEntriesByType("navigation")[0];
      const state = history.state;
      if (!nav || nav.type !== "reload" || !state || !state.scrollY) return;
      const scrollX = state.scrollX || 0;
      const y = state.scrollY;
      const root = document.documentElement;
      root.setAttribute("data-restore-scroll", "");
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        scrollTo({ left: scrollX, top: y });
        root.removeAttribute("data-restore-scroll");
      };
      const tryRestore = () => {
        if (done) return;
        // Layout is available during parsing; wait until the document is
        // tall enough for y instead of clamping to a half-parsed page.
        if (root.scrollHeight - window.innerHeight >= y) finish();
        else requestAnimationFrame(tryRestore);
      };
      requestAnimationFrame(tryRestore);
      // Hard caps so a hanging subresource can never leave the page blank.
      addEventListener("load", finish, { once: true });
      setTimeout(finish, 2000);
    } catch {}
  })();
</script>
