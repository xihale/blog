---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
import FontLoader from "./FontLoader.astro";

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, robots } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fffffd" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#17191d" media="(prefers-color-scheme: dark)" />
{robots && <meta name="robots" content={robots} />}
<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
<link rel="sitemap" href="/sitemap.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<FontLoader />

<!-- Page-specific Metadata -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL("/avatars/avatar.jpg", Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL("/avatars/avatar.jpg", Astro.url)} />

<script is:inline>
  (() => {
    const darkReaderLockSelector = 'meta[name="darkreader-lock"]';
    const preferredDark = window.matchMedia("(prefers-color-scheme: dark)");

    const addDarkReaderLock = () => {
      if (document.head.querySelector(darkReaderLockSelector)) return;
      const lock = document.createElement("meta");
      lock.name = "darkreader-lock";
      document.head.append(lock);
    };

    const removeDarkReaderLock = () => {
      const lock = document.head.querySelector(darkReaderLockSelector);
      if (lock) lock.remove();
    };

    const syncDarkReaderLock = () => {
      if (preferredDark.matches) {
        addDarkReaderLock();
      } else {
        removeDarkReaderLock();
      }
    };

    syncDarkReaderLock();

    preferredDark.addEventListener?.("change", syncDarkReaderLock);
  })();
</script>
