---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
import FontLoader from "./FontLoader.astro";
import { getImage } from "astro:assets";
import avatarImg from "../assets/images/avatar.jpg";
import faviconImg from "../assets/images/favicon.jpg";

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, robots } = Astro.props;

const favicon = await getImage({ src: faviconImg, format: "jpg" });
const ogImage = await getImage({ src: avatarImg, format: "jpg", width: 1200, height: 630 });
const ogImageUrl = new URL(ogImage.src, Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fffffd" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#17191d" media="(prefers-color-scheme: dark)" />
{robots && <meta name="robots" content={robots} />}
<link rel="icon" type="image/jpeg" href={favicon.src} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/atom+xml"
  title={SITE_TITLE}
  href={new URL("atom.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<FontLoader />

<!-- Page-specific Metadata -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<script is:inline>
  // Firefox (144+, Zen included) paints 1-2 blank frames between the old and
  // new snapshots of a same-document view transition; Chrome does not, so
  // every ClientRouter navigation flashes there. Dropping the API makes Astro
  // take its fallback="swap" path: a direct DOM swap, which is also what this
  // site's animation: none view-transition CSS intends. Must stay an inline
  // classic script: module scripts are deferred, and Astro's router reads
  // document.startViewTransition when its module first evaluates.
  if (navigator.userAgent.includes("Firefox")) {
    document.startViewTransition = undefined;
  }
</script>
