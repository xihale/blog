---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// Filter for h2-h4 and ensure minimum count
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  tocItems.length >= 2 && (
    <div class="toc" id="toc">
      {tocItems.map(({ depth, slug, text }) => (
        <div
          class={`toc-item toc-level-${depth}`}
          style={`padding-left: ${Math.max(0, depth - 2) * 2}ch`}
        >
          <a href={`#${slug}`} class="toc-link" data-toc-id={slug}>
            {text}
          </a>
        </div>
      ))}
    </div>
  )
}

<script>
  let tocScrollHandler: (() => void) | null = null;

  function initTableOfContents() {
    // Early mobile check - skip all TOC interactions on mobile
    if (window.innerWidth <= 768) return;

    const toc = document.getElementById("toc");
    if (!toc) return;

    const links = toc.querySelectorAll(".toc-link");

    function updateCurrentHeading() {
      const headings = Array.from(
        document.querySelectorAll(
          ".article-content h2, .article-content h3, .article-content h4",
        ),
      ) as HTMLElement[];

      if (headings.length === 0) return;

      // Find current heading based on scroll position
      const scrollPosition = window.scrollY + 100;
      let currentHeading: HTMLElement | null = null;

      for (let i = headings.length - 1; i >= 0; i--) {
        const heading = headings[i];
        if (heading && heading.offsetTop <= scrollPosition) {
          currentHeading = heading;
          break;
        }
      }

      if (!currentHeading && headings.length > 0) {
        currentHeading = headings[0] ?? null;
      }

      if (currentHeading) {
        const headingId = currentHeading.id;

        // Update active states
        links.forEach((link) => {
          const linkId = link.getAttribute("data-toc-id");
          const htmlLink = link as HTMLElement;
          if (linkId === headingId) {
            htmlLink.style.fontWeight = "bold";
            htmlLink.style.color = "var(--color-text)";
          } else {
            htmlLink.style.fontWeight = "";
            htmlLink.style.color = "";
          }
        });
      }
    }

    // Update on scroll with throttling
    let scrollTimer: number | null = null;
    function handleScroll() {
      if (scrollTimer) {
        window.cancelAnimationFrame(scrollTimer);
      }
      scrollTimer = window.requestAnimationFrame(updateCurrentHeading);
    }

    // Clean up previous handler if exists
    if (tocScrollHandler) {
      window.removeEventListener("scroll", tocScrollHandler);
    }

    tocScrollHandler = handleScroll;
    updateCurrentHeading();
    window.addEventListener("scroll", handleScroll);
  }

  // Run on initial page load and every navigation
  document.addEventListener("astro:page-load", initTableOfContents);
</script>

<style>
  @import "../styles/components/toc.css";
</style>
