---
import styles from "./TableOfContents.module.css";

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

type TocNode = {
  id: string;
  text: string;
  children: TocNode[];
};

const { headings } = Astro.props as Props;
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

const tocTree: TocNode[] = [];
let currentH2: TocNode | null = null;

for (const item of tocItems) {
  if (item.depth === 2 || !currentH2) {
    const node: TocNode = { id: item.slug, text: item.text, children: [] };
    tocTree.push(node);
    currentH2 = node;
    continue;
  }

  currentH2.children.push({ id: item.slug, text: item.text, children: [] });
}
---

{
  tocItems.length >= 2 && (
    <nav class={styles["toc"]} aria-label="文章目录">
      <details class={styles["details"]} data-toc-details>
        <summary class={styles["summary"]}>
          <span class={styles["chevron"]} aria-hidden="true">
            ›
          </span>
          <span class={styles["title"]}>目录</span>
        </summary>

        <ol class={styles["list"]}>
          {tocTree.map((h2) => (
            <li>
              <a href={`#${h2.id}`} class={styles["linkH2"]}>
                {h2.text}
              </a>

              {h2.children.length > 0 && (
                <ol class={styles["sublist"]}>
                  {h2.children.map((h3) => (
                    <li>
                      <a href={`#${h3.id}`} class={styles["linkH3"]}>
                        {h3.text}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  // 点击任意章节跳转后自动收起目录
  const bind = () => {
    document.querySelectorAll<HTMLDetailsElement>("[data-toc-details]").forEach((details) => {
      details.addEventListener("click", (e) => {
        if (!details.open) return;
        const target = e.target instanceof Element ? e.target : null;
        if (target?.closest("a")) details.open = false;
      });
    });
  };

  document.addEventListener("astro:page-load", bind);
  bind();
</script>
