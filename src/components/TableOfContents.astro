---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// Filter for h2-h4 and ensure minimum count
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

import "../styles/components/toc.css";
---

{
  tocItems.length >= 2 && (
    <nav class="toc" aria-label="Table of contents">
      <p class="toc-title">目录</p>
      <div class="toc-list">
        {tocItems.map(({ depth, slug, text }) => (
          <div class={`toc-item toc-level-${depth}`}>
            <a href={`#${slug}`} class="toc-link" title={text}>
              {text}
            </a>
          </div>
        ))}
      </div>
    </nav>
  )
}
