---
import LinkCard from "./LinkCard.astro";
import type { LinkGroup } from "../data/links";
import styles from "./LinkGroupSection.module.css";

interface Props {
  group: LinkGroup;
}

const { group } = Astro.props;
---

<section class={styles["linkGroup"]}>
  <header class={styles["header"]}>
    <h2>{group.title}</h2>
    {group.description && <p class={styles["description"]}>{group.description}</p>}
  </header>

  <div class={styles["linkGrid"]}>
    {group.links.map((item) => <LinkCard {...item} />)}
  </div>
</section>
