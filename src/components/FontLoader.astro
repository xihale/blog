---
/*
  FontLoader.astro
  Handles font preloading and global @font-face declarations.
*/
---

<!-- Font Preload with highest priority -->
<link
  rel="preload"
  href="/fonts/lxgw.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Critical CSS for immediate font application -->
<style is:global>
  @font-face {
    font-family: "LXGW WenKai Subset";
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: url("/fonts/lxgw.woff2") format("woff2");
  }

  @font-face {
    font-family: "JetBrains Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/jbmono.woff2") format("woff2");
  }
</style>
