---
/**
 * Giscus Comments Component
 * Refactored from local JSON sync to Giscus (GitHub Discussions)
 */

interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;

// --- Giscus Configuration ---
// TO USER: Replace the following values with your own from https://giscus.app/
const REPO = "xihale/blog";
const REPO_ID = "R_kgDOMq2pmQ";
const CATEGORY = "General";
const CATEGORY_ID = "DIC_kwDOMq2pmc4C7P7J";
// ----------------------------
---

<section class="comments-section">
  <div class="comments-container">
    <div class="giscus-wrapper">
      <div class="giscus"></div>
    </div>
  </div>
</section>

<script is:inline
  src="https://giscus.app/client.js"
  data-repo={REPO}
  data-repo-id={REPO_ID}
  data-category={CATEGORY}
  data-category-id={CATEGORY_ID}
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="0"
  data-input-position="top"
  data-theme="https://xihale.top/styles/giscus.css"
  data-lang="zh-CN"
  data-loading="lazy"
  crossorigin="anonymous"
  async
></script>

<style>
  .comments-section {
    margin-top: var(--space-12);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-header-divider);
    position: relative;
    /* Ensure no clipping of shadows */
    padding-right: 8px; 
    overflow: visible;
  }

  .comments-container {
    max-width: 100%;
    overflow: visible;
  }

  .giscus-wrapper {
    min-height: 150px;
    overflow: visible;
  }

  /* Force Giscus to respect container width while allowing for shadows */
  :global(.giscus), :global(.giscus-frame) {
    width: 100% !important;
    max-width: 100% !important;
  }
</style>

<script is:inline>
  function updateGiscusTheme() {
    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    const iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;

    iframe.contentWindow.postMessage(
      { 
        giscus: { 
          setConfig: { 
            theme: `https://xihale.top/styles/giscus.css?v=${Date.now()}` 
          } 
        } 
      },
      'https://giscus.app'
    );
  }

  // Monitor class changes on <html>
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        updateGiscusTheme();
      }
    });
  });

  observer.observe(document.documentElement, { attributes: true });

  // Astro page transitions support
  document.addEventListener('astro:page-load', () => {
    updateGiscusTheme();
  });

  // Fallback
  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://giscus.app') return;
    if (event.data.giscus && event.data.giscus.discussion) {
      // Giscus component loaded
      updateGiscusTheme();
    }
  });
</script>
