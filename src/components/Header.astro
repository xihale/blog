---
import { SITE_TITLE } from "../consts";
import styles from "./Header.module.css";

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/tags", label: "Tags" },
  { href: "/blog", label: "Blog" },
  { href: "/links", label: "Links" },
  { href: "/about", label: "About" },
];

const isCurrent = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class={styles["siteHeader"]}>
  <div class={styles["headerContainer"]}>
    <!-- Logo/Title -->
    <nav class={styles["brandTitle"]}>
      <a href="/" class={styles["navLink"]}>
        {SITE_TITLE}
      </a>
    </nav>

    <!-- Desktop Navigation Menu -->
    <nav class={styles["navMenuDesktop"]}>
      {
        navItems.map(({ href, label }) => (
          <a
            href={href}
            class:list={[styles["navLink"], isCurrent(href) && styles["navLinkActive"]]}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile menu button -->
    <button
      class={styles["mobileMenuToggle"]}
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      data-open="false"
      id="mobile-menu-button"
    >
      <span class={styles["mobileMenuLine"]}></span>
      <span class={styles["mobileMenuLine"]}></span>
      <span class={styles["mobileMenuLine"]}></span>
    </button>
  </div>

  <!-- Mobile Navigation Menu -->
  <nav class={styles["navMenuMobile"]} data-open="false" id="nav-menu">
    <div class={styles["navMenuContainer"]}>
      {
        navItems.map(({ href, label }) => (
          <a
            href={href}
            class:list={[styles["navLink"], isCurrent(href) && styles["navLinkActive"]]}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const initMobileMenu = () => {
    const button = document.getElementById("mobile-menu-button");
    const nav = document.getElementById("nav-menu");

    if (!button || !nav) return;

    // Remove existing listeners to prevent duplicates if any (though unlikely with ViewTransitions replacing DOM)
    // Actually, simple cloneNode or just one-time setup is tricky with ViewTransitions.
    // The previous code was fine, just rewriting for style.

    const toggleMenu = () => {
      const isOpen = nav.dataset["open"] !== "true";
      nav.dataset["open"] = isOpen ? "true" : "false";
      button.dataset["open"] = isOpen ? "true" : "false";
      button.setAttribute("aria-expanded", isOpen.toString());
    };

    button.addEventListener("click", toggleMenu);
  };

  // Runs on initial load and after every View Transition navigation
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
