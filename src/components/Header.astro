---
import { SITE_TITLE } from "../consts";
import styles from "./Header.module.css";

const currentPath = Astro.url.pathname;
// 首页 hero 已有大墨滴，header 徽记只在子页面出现
const isHome = currentPath === "/";
const navItems: Array<{ href: string; label: string; external?: boolean }> = [
  { href: "/categories", label: "Categories" },
  { href: "/tags", label: "Tags" },
  { href: "/writing", label: "Writing" },
  { href: "/links", label: "Links" },
  { href: "/about", label: "About" },
];

const isCurrent = (href: string, external?: boolean) => {
  if (external) {
    return false;
  }

  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class={styles["siteHeader"]}>
  <div class={styles["headerContainer"]}>
    <nav class={styles["brandTitle"]}>
      <a href="/" class={styles["navLink"]}>
        {!isHome && (
          <svg class={styles["brandInk"]} viewBox="0 0 256 256" aria-hidden="true">
            <mask id="brandInkMask" maskUnits="userSpaceOnUse">
              <rect width="256" height="256" fill="#fff" />
              <g fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round">
                <path class={styles["brandInkTrunk"]} stroke-width="10" pathLength="100"
                  d="M 126 252 C 126 200, 123 148, 136 92" />
                <path class={styles["brandInkBranchL"]} stroke-width="7.5" pathLength="100"
                  d="M 127 150 C 112 142, 97 135, 81 117" />
                <path class={styles["brandInkBranchR"]} stroke-width="7" pathLength="100"
                  d="M 129 131 C 144 121, 158 111, 168 100" />
              </g>
            </mask>
            <path class={styles["brandInkBody"]} fill="currentColor" mask="url(#brandInkMask)"
              d="M 128 20 C 132 20, 135 24, 137 29 C 156 76, 208 122, 208 168 C 208 214, 172 240, 128 240 C 84 240, 48 214, 48 168 C 48 122, 100 76, 119 29 C 121 24, 124 20, 128 20 Z" />
          </svg>
        )}
        {SITE_TITLE}
      </a>
    </nav>

    <nav class={styles["navMenuDesktop"]}>
      {
        navItems.map(({ href, label, external }) => (
          <a
            href={href}
            class:list={[styles["navLink"], isCurrent(href, external) && styles["navLinkActive"]]}
            aria-current={isCurrent(href, external) ? "page" : undefined}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer noopener" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <button
      class={styles["mobileMenuToggle"]}
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      data-open="false"
      id="mobile-menu-button"
    >
      <span class={styles["mobileMenuLine"]}></span>
      <span class={styles["mobileMenuLine"]}></span>
      <span class={styles["mobileMenuLine"]}></span>
    </button>
  </div>

  <nav class={styles["navMenuMobile"]} data-open="false" id="nav-menu">
    <div class={styles["navMenuContainer"]}>
      {
        navItems.map(({ href, label, external }) => (
          <a
            href={href}
            class:list={[styles["navLink"], isCurrent(href, external) && styles["navLinkActive"]]}
            aria-current={isCurrent(href, external) ? "page" : undefined}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer noopener" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const initMobileMenu = () => {
    const button = document.getElementById("mobile-menu-button");
    const nav = document.getElementById("nav-menu");

    if (!button || !nav) return;

    const toggleMenu = () => {
      const isOpen = nav.dataset["open"] !== "true";
      nav.dataset["open"] = isOpen ? "true" : "false";
      button.dataset["open"] = isOpen ? "true" : "false";
      button.setAttribute("aria-expanded", isOpen.toString());
    };

    button.addEventListener("click", toggleMenu);
  };

  document.addEventListener("astro:page-load", initMobileMenu);
</script>
