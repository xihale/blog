---
import { SITE_TITLE } from "../consts";
import "../styles/components/header.css";

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/links", label: "Links" },
  { href: "/about", label: "About" },
];

const isCurrent = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="site-header bg-background border-b border-block shadow-sm">
  <div class="header-container">
    <!-- Logo/Title -->
    <nav class="site-title">
      <a href="/" class="nav-link">
        {SITE_TITLE}
      </a>
    </nav>

    <!-- Desktop Navigation Menu -->
    <nav class="nav-menu-desktop">
      {
        navItems.map(({ href, label }) => (
          <a href={href} class={`nav-link ${isCurrent(href) ? "nav-link-active" : ""}`} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile menu button -->
    <button
      class="mobile-menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      id="mobile-menu-button"
    >
      <span class="mobile-menu-line"></span>
      <span class="mobile-menu-line"></span>
      <span class="mobile-menu-line"></span>
    </button>
  </div>

  <!-- Mobile Navigation Menu -->
  <nav class="nav-menu-mobile" id="nav-menu">
    <div class="nav-menu-container">
      {
        navItems.map(({ href, label }) => (
          <a href={href} class={`nav-link ${isCurrent(href) ? "nav-link-active" : ""}`} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const initMobileMenu = () => {
    const button = document.getElementById("mobile-menu-button");
    const nav = document.getElementById("nav-menu");

    if (!button || !nav) return;

    // Remove existing listeners to prevent duplicates if any (though unlikely with ViewTransitions replacing DOM)
    // Actually, simple cloneNode or just one-time setup is tricky with ViewTransitions.
    // The previous code was fine, just rewriting for style.

    const toggleMenu = () => {
      const isOpen = nav.classList.toggle("nav-menu--open");
      button.classList.toggle("active", isOpen);
      button.setAttribute("aria-expanded", isOpen.toString());
    };

    button.addEventListener("click", toggleMenu);
  };

  // Runs on initial load and after every View Transition navigation
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
