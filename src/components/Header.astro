---
import { SITE_TITLE } from "../consts";
import styles from "./Header.module.css";

const currentPath = Astro.url.pathname;
// 首页 hero 已有大墨滴，header 徽记只在子页面出现
const isHome = currentPath === "/";
const navItems: Array<{ href: string; label: string; external?: boolean }> = [
  { href: "/writing/", label: "长文" },
  { href: "/fragments/", label: "碎语" },
  { href: "/tags/", label: "标签" },
  { href: "/links/", label: "友链" },
  { href: "/about/", label: "关于" },
];

const isCurrent = (href: string, external?: boolean) => {
  if (external) {
    return false;
  }

  if (href === "/") {
    return currentPath === "/";
  }

  const base = href.replace(/\/$/, "");
  return currentPath === base || currentPath.startsWith(`${base}/`);
};
---

<header class={styles["siteHeader"]}>
  <div class={styles["headerContainer"]}>
    <nav class={styles["brandTitle"]} aria-label="站点首页">
      <a href="/" class={styles["navLink"]}>
        {!isHome && (
          <svg class={styles["brandInk"]} viewBox="0 0 256 256" aria-hidden="true">
            <mask id="brandInkMask" maskUnits="userSpaceOnUse">
              <rect width="256" height="256" fill="#fff" />
              <g fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round">
                <path class={styles["brandInkTrunk"]} stroke-width="10"
                  d="M 126 252 C 126 200, 123 148, 136 92" />
                <path class={styles["brandInkBranchL"]} stroke-width="7.5"
                  d="M 127 150 C 112 142, 97 135, 81 117" />
                <path class={styles["brandInkBranchR"]} stroke-width="7"
                  d="M 129 131 C 144 121, 158 111, 168 100" />
              </g>
            </mask>
            <path class={styles["brandInkBody"]} fill="currentColor" mask="url(#brandInkMask)"
              d="M 128 20 C 132 20, 135 24, 137 29 C 156 76, 208 122, 208 168 C 208 214, 172 240, 128 240 C 84 240, 48 214, 48 168 C 48 122, 100 76, 119 29 C 121 24, 124 20, 128 20 Z" />
          </svg>
        )}
        {SITE_TITLE}
      </a>
    </nav>

    <nav class={styles["navMenuDesktop"]} aria-label="主导航">
      {
        navItems.map(({ href, label, external }) => (
          <a
            href={href}
            class:list={[styles["navLink"], isCurrent(href, external) && styles["navLinkActive"]]}
            aria-current={isCurrent(href, external) ? "page" : undefined}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer noopener" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <button
      class={styles["mobileMenuToggle"]}
      aria-label="展开或收起导航菜单"
      aria-expanded="false"
      aria-controls="nav-menu"
      data-open="false"
      id="mobile-menu-button"
      type="button"
    >
      <span class={styles["mobileMenuLine"]}></span>
      <span class={styles["mobileMenuLine"]}></span>
      <span class={styles["mobileMenuLine"]}></span>
    </button>
  </div>

  <nav class={styles["navMenuMobile"]} data-open="false" id="nav-menu" aria-label="移动端主导航">
    <div class={styles["navMenuContainer"]}>
      {
        navItems.map(({ href, label, external }) => (
          <a
            href={href}
            class:list={[styles["navLink"], isCurrent(href, external) && styles["navLinkActive"]]}
            aria-current={isCurrent(href, external) ? "page" : undefined}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer noopener" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const setMobileMenuOpen = (open: boolean) => {
    const button = document.getElementById("mobile-menu-button");
    const nav = document.getElementById("nav-menu");
    if (!button || !nav) return;
    const state = open ? "true" : "false";
    nav.dataset["open"] = state;
    button.dataset["open"] = state;
    button.setAttribute("aria-expanded", state);
  };

  document.addEventListener("click", (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;

    if (target.closest("#mobile-menu-button")) {
      const nav = document.getElementById("nav-menu");
      setMobileMenuOpen(nav?.dataset["open"] !== "true");
      return;
    }

    const nav = document.getElementById("nav-menu");
    if (nav?.dataset["open"] === "true") {
      if (target.closest("#nav-menu a") || !target.closest("header")) {
        setMobileMenuOpen(false);
      }
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      setMobileMenuOpen(false);
    }
  });

  document.addEventListener("astro:after-swap", () => {
    setMobileMenuOpen(false);
  });
</script>
