---
import { Image } from "astro:assets";
import type { LinkItem } from "../data/links";
import styles from "./LinkCard.module.css";

interface Props extends LinkItem {}

const { name, url, avatar, description } = Astro.props;

let host = url;
try {
  host = new URL(url).hostname.replace(/^www\./, "");
} catch {
  host = url;
}
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class={styles["linkCard"]}
>
  {
    avatar && (
      <div class={styles["avatarWrap"]}>
        <Image src={avatar} alt={name} class={styles["avatar"]} width={40} height={40} loading="lazy" />
      </div>
    )
  }

  <div class={styles["body"]}>
    <div class={styles["titleRow"]}>
      <span class={styles["name"]}>{name}</span>
      <span class={styles["host"]}>{host}</span>
    </div>
    <p class={styles["description"]}>{description}</p>
  </div>
</a>
