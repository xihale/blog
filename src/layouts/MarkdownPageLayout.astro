---
import BaseLayout from "./BaseLayout.astro";
import { SITE_DESCRIPTION } from "../consts";
import "../styles/components/article.css";
import "../styles/components/admonitions.css";
import "../styles/components/code.css";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    robots?: string;
  };
}

const props = Astro.props as Props;
const title = props.title ?? props.frontmatter?.title;
const description = props.description ?? props.frontmatter?.description ?? SITE_DESCRIPTION;
const robots = props.robots ?? props.frontmatter?.robots;

const baseLayoutProps: {
  description: string;
  robots?: string;
  title?: string;
} = robots ? { description, robots } : { description };

if (typeof title === "string") {
  baseLayoutProps.title = title;
}
---

<BaseLayout {...baseLayoutProps}>
  {
    title && (
      <header class="page-header">
        <h1>{title}</h1>
      </header>
    )
  }
  <article class="article-content body-text">
    <slot />
  </article>
</BaseLayout>
