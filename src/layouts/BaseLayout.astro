---
interface Props {
	title?: string;
	description?: string;
}

const { title: frontmatterTitle, description = SITE_DESCRIPTION } = Astro.props;

// For markdown files, try to get title from frontmatter or use pathname-based title
let title = frontmatterTitle;
if (!title && Astro.url.pathname !== '/') {
  // Extract title from pathname for markdown files
  const pathName = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
  if (pathName) {
    title = pathName.charAt(0).toUpperCase() + pathName.slice(1).replace(/-/g, ' ');
  }
}

// If title is not provided, use SITE_TITLE (for homepage)
// If title is provided and it's not SITE_TITLE, use "title | SITE_TITLE"
const pageTitle = title ? (title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`) : SITE_TITLE;
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={description} />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<div class="flex flex-col mx-auto px-4 w-full max-w-4xl flex-grow pt-20">
			<main class="flex-grow py-8">
				<slot />
			</main>
		</div>

		<!-- Global Footer -->
		<footer class="bg-[var(--color-background)] border-t border-[var(--color-border)]">
			<div class="mx-auto px-4 w-full max-w-4xl py-3">
				<div class="flex items-center justify-between text-sm">
					<p class="text-[var(--color-text-muted)]">
						Built with <a href="https://astro.build/" class="text-[var(--color-text-secondary)]">Astro</a> •
						Minimal by design
					</p>
					<a href="/rss.xml" class="text-[var(--color-text-muted)]" title="RSS Feed">
						RSS
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
