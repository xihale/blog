---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_ICP, SITE_ICP_URL } from "../consts";
import { ClientRouter } from "astro:transitions";
import katexCss from "katex/dist/katex.min.css?url";

interface Props {
	title?: string;
	description?: string;
	robots?: string;
	contentWidth?: "default" | "wide";
	math?: boolean;
}

const {
	title: frontmatterTitle,
	description = SITE_DESCRIPTION,
	robots,
	contentWidth = "default",
	math = false,
} = Astro.props;

// For markdown files, try to get title from frontmatter or use pathname-based title
let title = frontmatterTitle;
if (!title && Astro.url.pathname !== "/") {
	// Extract title from pathname for markdown files
	const pathName = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
	if (pathName) {
		title =
			pathName.charAt(0).toUpperCase() + pathName.slice(1).replace(/-/g, " ");
	}
}

// If title is not provided, use SITE_TITLE (for homepage)
// If title is provided and it's not SITE_TITLE, use "title | SITE_TITLE"
const pageTitle = title
	? title === SITE_TITLE
		? SITE_TITLE
		: `${title} | ${SITE_TITLE}`
	: SITE_TITLE;

const baseHeadProps = robots
	? { title: pageTitle, description, robots }
	: { title: pageTitle, description };

const siteContentClass =
	contentWidth === "wide" ? "site-content site-content-wide" : "site-content";
const currentYear = new Date().getFullYear();
---

<!doctype html>
	<html lang="zh-CN">
	<head>
		<BaseHead {...baseHeadProps} />
		{math && <link rel="stylesheet" href={katexCss} />}
		<ClientRouter fallback="swap" />
	</head>
	<body class="site-layout">
		<Header />
		<div class={siteContentClass}>
			<div class="px-[0.3333rem] md:px-2">
				<main class="site-main">
					<slot />
				</main>
			</div>
		</div>

		<footer class="site-footer">
			<div class="site-footer-inner">
				<div class="site-footer-left">
					<span class="site-footer-copy">© {currentYear} {SITE_TITLE}</span>
					<a
						href={SITE_ICP_URL}
						class="site-footer-link site-footer-icp"
						target="_blank"
						rel="noopener noreferrer"
					>
						{SITE_ICP}
					</a>
				</div>
				<nav class="site-footer-nav" aria-label="Footer navigation">
					<a href="/rss.xml" class="site-footer-link" title="RSS Feed">RSS</a>
					<a href="/atom.xml" class="site-footer-link" title="Atom Feed">Atom</a>
					<a href="https://astro.build/" class="site-footer-link">Astro</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
