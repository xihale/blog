---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	robots?: string;
	contentWidth?: "default" | "wide";
}

const {
	title: frontmatterTitle,
	description = SITE_DESCRIPTION,
	robots,
	contentWidth = "default",
} = Astro.props;

// For markdown files, try to get title from frontmatter or use pathname-based title
let title = frontmatterTitle;
if (!title && Astro.url.pathname !== "/") {
	// Extract title from pathname for markdown files
	const pathName = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
	if (pathName) {
		title =
			pathName.charAt(0).toUpperCase() + pathName.slice(1).replace(/-/g, " ");
	}
}

// If title is not provided, use SITE_TITLE (for homepage)
// If title is provided and it's not SITE_TITLE, use "title | SITE_TITLE"
const pageTitle = title
	? title === SITE_TITLE
		? SITE_TITLE
		: `${title} | ${SITE_TITLE}`
	: SITE_TITLE;

const baseHeadProps = robots
	? { title: pageTitle, description, robots }
	: { title: pageTitle, description };

const siteContentClass =
	contentWidth === "wide" ? "site-content site-content-wide" : "site-content";

const footerLinkClass =
	"text-[var(--color-nav-link)] transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-[var(--color-nav-link-hover)] focus-visible:text-[var(--color-nav-link-hover)]";
---

<!doctype html>
	<html lang="zh-CN">
	<head>
		<BaseHead {...baseHeadProps} />
		<link rel="stylesheet" href="https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/KaTeX/0.16.9/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />
		<ClientRouter fallback="swap" />
	</head>
	<body class="site-layout">
		<Header />
		<div class={siteContentClass}>
			<div class="px-2">
				<main class="site-main">
					<slot />
				</main>
			</div>
		</div>

		<!-- Global Footer -->
		<footer class="bg-[var(--color-background)] border-t border-[var(--color-border)]">
			<div class="mx-auto px-4 w-full max-w-4xl py-3">
				<div class="site-footer">
					<span>
						<a href="https://astro.build/" class={footerLinkClass}>Astro</a> • Minimal
					</span>
					<a href="/rss.xml" class={footerLinkClass} title="RSS Feed"> RSS </a>
				</div>
			</div>
		</footer>
	</body>
</html>
