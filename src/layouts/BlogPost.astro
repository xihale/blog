---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, formatDateISO } from "../utils/date";
import TableOfContents from "../components/TableOfContents.astro";
import "../styles/components/article.css";
import "../styles/components/admonitions.css";
import "../styles/components/code.css";

type Props = CollectionEntry<"blog">["data"] & {
  unlisted?: boolean | undefined;
  headings?: Array<{ depth: number; slug: string; text: string }> | undefined;
  tags?: string[] | undefined;
  math?: boolean | undefined;
  mermaid?: boolean | undefined;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	unlisted,
	cover,
	math,
	mermaid,
	headings = [],
} = Astro.props;

const robots = unlisted ? "noindex" : undefined;

const baseLayoutProps = {
  title,
  description,
  ...(robots ? { robots } : {}),
  ...(cover ? { cover } : {}),
  ...(math !== undefined ? { math } : {}),
};

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = tocHeadings.length >= 2;
---

<BaseLayout {...baseLayoutProps} contentWidth="wide">
  <article class="mx-auto max-w-[88rem] blog-post-layout">
    <!-- Article Header -->
    <header class="article-header">
      <h1>
        {title}
      </h1>

      <div class="article-meta-container">
        <time datetime={formatDateISO(pubDate)} class="font-mono">
          {formatDate(pubDate)}
        </time>

        {
          updatedDate && (
            <time datetime={formatDateISO(updatedDate)} class="font-mono">
              · 更新于 {formatDate(updatedDate)}
            </time>
          )
        }

        {
          tags && tags.length > 0 && (
            <div class="tag-container">
              {tags.map((tag: string) => (
                <a href={`/tags/#tag-${tag}`} class="tag tag-dir-link">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

      <div class="article-shell">
        <div class="article-main">
          {hasToc && <TableOfContents headings={tocHeadings} />}
          <main class="article-content body-text">
            <slot />
          </main>

          <script is:inline>
            const articleContent = document.querySelector(".article-content");

            if (articleContent instanceof HTMLElement) {
              const headingNodes = articleContent.querySelectorAll(
                "h2[id], h3[id], h4[id], h5[id], h6[id]",
              );

              headingNodes.forEach((headingNode) => {
                if (!(headingNode instanceof HTMLElement)) return;
                if (headingNode.querySelector(":scope > a.heading-anchor")) return;

                const headingId = headingNode.id.trim();
                if (!headingId) return;

                const anchor = document.createElement("a");
                anchor.className = "heading-anchor";
                anchor.href = `#${headingId}`;
                anchor.textContent = "#";
                anchor.setAttribute("aria-label", `链接到标题：${headingNode.textContent?.trim() ?? headingId}`);

                headingNode.prepend(anchor);
              });
            }
          </script>
          {mermaid && (
            <script is:inline defer src="https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/mermaid/11.4.1/mermaid.min.js"></script>
          )}
          {mermaid && (
            <script is:inline>
              // mermaid.min.js is defer, so it has executed by DOMContentLoaded —
              // calling initialize synchronously during parse would hit an
              // undefined global and abort (mermaid's default startOnLoad would
              // then render with the wrong theme).
              document.addEventListener("DOMContentLoaded", () => {
                mermaid.initialize({ startOnLoad: true, theme: "neutral" });
              });
            </script>
          )}
        </div>
      </div>
  </article>
</BaseLayout>
