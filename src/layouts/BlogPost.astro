---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, formatDateISO } from "../utils/date";
import TableOfContents from "../components/TableOfContents.astro";

type Props = CollectionEntry<"blog">["data"] & {
  unlisted?: boolean | undefined;
  headings?: Array<{ depth: number; slug: string; text: string }> | undefined;
  tags?: string[] | undefined;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  unlisted,
  headings = [],
} = Astro.props;

const robots = unlisted ? "noindex" : undefined;
---

<BaseLayout title={title} description={description} robots={robots}>
  <div class="min-h-screen">
    <article class="container-center responsive-padding">
      <!-- Article Header -->
      <header class="article-header">
        <h1>
          {title}
        </h1>

        <div class="article-meta-container">
          <time datetime={formatDateISO(pubDate)} class="font-mono">
            {formatDate(pubDate)}
          </time>

          {
            updatedDate && (
              <time datetime={formatDateISO(updatedDate)} class="font-mono">
                | {formatDate(updatedDate)}
              </time>
            )
          }
        </div>

        {
          tags && tags.length > 0 && (
            <div class="tag-container">
              {tags.map((tag: string) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <!-- Table of Contents outside container -->
      <TableOfContents headings={headings} />

      <!-- Article Content -->
      <main class="article-content section-spacing body-text">
        <slot />
      </main>
    </article>
  </div>
</BaseLayout>
