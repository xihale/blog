---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, formatDateISO } from "../utils/date";
import TableOfContents from "../components/TableOfContents.astro";

type Props = CollectionEntry<"blog">["data"] & {
  unlisted?: boolean | undefined;
  headings?: Array<{ depth: number; slug: string; text: string }> | undefined;
  tags?: string[] | undefined;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  unlisted,
  headings = [],
} = Astro.props;

const robots = unlisted ? "noindex" : undefined;

const baseLayoutProps = robots
  ? { title, description, robots }
  : { title, description };

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const hasToc = tocHeadings.length >= 2;
const articleShellClass = hasToc ? "article-shell has-toc" : "article-shell";
---

<BaseLayout {...baseLayoutProps} contentWidth="wide">
  <div class="min-h-screen">
    <article class="container-center responsive-padding blog-post-layout">
      <!-- Article Header -->
      <header class="article-header">
        <h1>
          {title}
        </h1>

        <div class="article-meta-container">
          <time datetime={formatDateISO(pubDate)} class="font-mono">
            {formatDate(pubDate)}
          </time>

          {
            updatedDate && (
              <time datetime={formatDateISO(updatedDate)} class="font-mono">
                | {formatDate(updatedDate)}
              </time>
            )
          }
        </div>

        {
          tags && tags.length > 0 && (
            <div class="tag-container">
              {tags.map((tag: string) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <div class={articleShellClass}>
        {
          hasToc && (
            <aside class="article-toc-wrap">
              <TableOfContents headings={tocHeadings} />
            </aside>
          )
        }

        <div class="article-main">
          <main class="article-content section-spacing body-text">
            <slot />
          </main>

          <script is:inline>
            const articleContent = document.querySelector(".article-content");

            if (articleContent instanceof HTMLElement) {
              const headingNodes = articleContent.querySelectorAll(
                "h2[id], h3[id], h4[id], h5[id], h6[id]",
              );

              headingNodes.forEach((headingNode) => {
                if (!(headingNode instanceof HTMLElement)) return;
                if (headingNode.querySelector(":scope > a.heading-anchor")) return;

                const headingId = headingNode.id.trim();
                if (!headingId) return;

                const anchor = document.createElement("a");
                anchor.className = "heading-anchor";
                anchor.href = `#${headingId}`;
                anchor.textContent = "#";
                anchor.setAttribute("aria-label", `链接到标题：${headingNode.textContent?.trim() ?? headingId}`);

                headingNode.prepend(anchor);
              });
            }
          </script>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
