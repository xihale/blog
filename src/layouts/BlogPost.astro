---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, formatDateISO } from "../utils/date";
import TableOfContents from "../components/TableOfContents.astro";

type Props = CollectionEntry<"blog">["data"] & {
  unlisted?: boolean | undefined;
  headings?: Array<{ depth: number; slug: string; text: string }> | undefined;
  tags?: string[] | undefined;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  unlisted,
  headings = [],
} = Astro.props;

const robots = unlisted ? "noindex" : undefined;

const baseLayoutProps = robots
  ? { title, description, robots }
  : { title, description };

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const hasToc = tocHeadings.length >= 2;
const articleShellClass = hasToc ? "article-shell has-toc" : "article-shell";
---

<BaseLayout {...baseLayoutProps} contentWidth="wide">
  <div class="min-h-screen">
    <article class="container-center responsive-padding blog-post-layout">
      <div class={articleShellClass}>
        {
          hasToc && (
            <aside class="article-toc-wrap">
              <TableOfContents headings={tocHeadings} />
            </aside>
          )
        }

        <div class="article-main">
          <!-- Article Header -->
          <header class="article-header">
            <h1>
              {title}
            </h1>

            <div class="article-meta-container">
              <time datetime={formatDateISO(pubDate)} class="font-mono">
                {formatDate(pubDate)}
              </time>

              {
                updatedDate && (
                  <time datetime={formatDateISO(updatedDate)} class="font-mono">
                    | {formatDate(updatedDate)}
                  </time>
                )
              }
            </div>

            {
              tags && tags.length > 0 && (
                <div class="tag-container">
                  {tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )
            }
          </header>

          <main class="article-content section-spacing body-text">
            <slot />
          </main>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
