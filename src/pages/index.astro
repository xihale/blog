---
import { Image } from "astro:assets";
import avatarImg from "../assets/images/avatar.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="min-h-[80vh] flex items-center justify-center">
    <div class="mx-auto max-w-3xl text-center">
      <section class="mb-8 text-center">
        <div class="mb-8">
          <Image
            src={avatarImg}
            alt="xihale"
            class="mx-auto h-[150px] w-[150px] rounded-full object-cover"
            width={150}
            height={150}
          />
        </div>
        <h1 class="mb-4 text-5xl font-light font-serif text-[var(--color-text)]">
          Leisure Thoughts
        </h1>
        <p class="mx-auto mb-6 max-w-[34rem] text-[var(--color-text-secondary)]">
          Essays, notes, and a quieter personal corner.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
