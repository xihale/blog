---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, formatDateISO } from "../utils/date";

const [allBlogPosts, allFragments] = await Promise.all([
  getCollection("blog", ({ data }) => data.draft !== true && data.unlisted !== true),
  getCollection("fragments", ({ data }) => data.draft !== true && data.unlisted !== true),
]);

const sortedBlog = allBlogPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pinnedBlog = sortedBlog.filter((post) => post.data.featured === true);
const featuredPosts = [
  ...pinnedBlog,
  ...sortedBlog.filter((post) => post.data.featured !== true),
].slice(0, 3);

const recentFragments = allFragments
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero" aria-label="种墨">
    <div class="hero-inner">
      <svg class="hero-emblem" viewBox="0 0 256 256" role="img" aria-label="墨滴中生长的小树">
        <mask id="heroInkMask" maskUnits="userSpaceOnUse">
          <rect width="256" height="256" fill="#fff" />
          <g fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round">
            <path
              class="hero-ink-trunk"
              stroke-width="10"
              pathLength="100"
              d="M 126 252 C 126 200, 123 148, 136 92"
            />
            <path
              class="hero-ink-branch-l"
              stroke-width="7.5"
              pathLength="100"
              d="M 127 150 C 112 142, 97 135, 81 117"
            />
            <path
              class="hero-ink-branch-r"
              stroke-width="7"
              pathLength="100"
              d="M 129 131 C 144 121, 158 111, 168 100"
            />
          </g>
        </mask>
        <path
          class="hero-ink-body"
          fill="currentColor"
          mask="url(#heroInkMask)"
          d="M 128 20 C 132 20, 135 24, 137 29 C 156 76, 208 122, 208 168 C 208 214, 172 240, 128 240 C 84 240, 48 214, 48 168 C 48 122, 100 76, 119 29 C 121 24, 124 20, 128 20 Z"
        />
      </svg>

      <h1 class="sr-only">种墨</h1>
      <p class="hero-tagline">落墨成字，静待抽枝。</p>
    </div>
  </section>

  <div class="home-index">
    {
      featuredPosts.length > 0 && (
        <section class="home-section" aria-labelledby="home-featured-heading">
          <div class="section-header">
            <h2 id="home-featured-heading">精选长文</h2>
            <a href="/writing/" class="section-more">全部长文 →</a>
          </div>

          <div class="featured-list">
            {featuredPosts.map((post) => (
              <a href={`/writing/${post.id}/`} class="featured-item">
                <time
                  datetime={formatDateISO(post.data.pubDate)}
                  class="entry-date"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <div class="featured-body">
                  <div class="entry-title-row">
                    <h3 class="entry-title">{post.data.title}</h3>
                    {post.data.tags?.[0] && (
                      <span class="entry-tag">#{post.data.tags[0]}</span>
                    )}
                  </div>
                  {post.data.description && (
                    <p class="entry-desc">{post.data.description}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      recentFragments.length > 0 && (
        <section class="home-section" aria-labelledby="home-fragments-heading">
          <div class="section-header">
            <h2 id="home-fragments-heading">近期短记</h2>
            <a href="/fragments/" class="section-more">全部短记 →</a>
          </div>

          <div class="notes-list">
            {recentFragments.map((note) => (
              <a href={`/fragments/${note.id}/`} class="note-item">
                <time
                  datetime={formatDateISO(note.data.pubDate)}
                  class="entry-date"
                >
                  {formatDate(note.data.pubDate)}
                </time>
                <span class="note-title">{note.data.title}</span>
                {note.data.tags?.[0] && (
                  <span class="entry-tag">#{note.data.tags[0]}</span>
                )}
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: 1.25rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-emblem {
    width: clamp(104px, 14vmin, 132px);
    height: auto;
    color: var(--color-text);
  }

  /* 抽枝动画：淡入 → 主干 → 左右枝 */
  .hero-ink-body {
    animation: hero-ink-fade 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-ink-trunk,
  .hero-ink-branch-l,
  .hero-ink-branch-r {
    stroke-dasharray: 100.5;
    stroke-dashoffset: 100.8;
    animation: hero-ink-grow 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-ink-trunk {
    animation-delay: 0.35s;
  }

  .hero-ink-branch-l {
    animation-delay: 0.9s;
    animation-duration: 0.5s;
  }

  .hero-ink-branch-r {
    animation-delay: 1.08s;
    animation-duration: 0.5s;
  }

  @keyframes hero-ink-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes hero-ink-grow {
    to { stroke-dashoffset: 0; }
  }

  .hero-tagline {
    margin-top: 1.15rem;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    animation: hero-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.65s both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .home-index {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-header h2 {
    font: 300 1.15rem/1.4 var(--font-serif);
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-more {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .section-more:hover,
  .section-more:focus-visible {
    color: var(--color-text);
  }

  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .featured-item {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: baseline;
  }

  .entry-date {
    font: 0.84rem/1.5 var(--font-mono);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .featured-body {
    min-width: 0;
  }

  .entry-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .entry-title {
    font: 400 1.1rem/1.45 var(--font-serif);
    color: var(--color-text);
    margin: 0;
    transition: color 0.2s ease;
  }

  .featured-item:hover .entry-title,
  .featured-item:focus-visible .entry-title {
    color: var(--article-link-color);
  }

  .entry-tag {
    font: 0.78rem/1.4 var(--font-mono);
    color: var(--color-text-muted);
  }

  .entry-desc {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.56;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .note-item {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: baseline;
  }

  .note-title {
    font: 400 1rem/1.5 var(--font-serif);
    color: var(--color-text);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .note-item:hover .note-title,
  .note-item:focus-visible .note-title {
    color: var(--article-link-color);
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: 0.75rem 2rem;
    }

    .featured-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .note-item {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      gap: 0.5rem;
    }

    .note-item .entry-tag {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ink-body,
    .hero-ink-trunk,
    .hero-ink-branch-l,
    .hero-ink-branch-r,
    .hero-tagline {
      animation: none !important;
    }

    .hero-ink-trunk,
    .hero-ink-branch-l,
    .hero-ink-branch-r {
      stroke-dashoffset: 0 !important;
    }
  }
</style>
