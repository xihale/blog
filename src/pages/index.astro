---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="hero-section">
    <div class="content-wrapper flex-center">
      <!-- Hero Section with Avatar -->
      <section class="section-spacing text-center">
        <div class="avatar-container mb-8">
          <img
            src="/avatar.jpg"
            alt="xihale"
            class="avatar-image rounded-full"
          />
        </div>
        <h1 class="heading-hero mb-4">Leisure Thoughts</h1>
      </section>
    </div>
  </div>
</BaseLayout>
