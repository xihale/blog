---
import { Image } from "astro:assets";
import avatarImg from "../assets/images/avatar.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="min-h-[80vh] flex items-center justify-center">
    <div class="mx-auto max-w-3xl text-center">
      <section class="mb-8 text-center">
        <div class="mb-8">
          <Image
            src={avatarImg}
            alt="xihale"
            class="mx-auto h-[150px] w-[150px] rounded-full object-cover"
            width={150}
            height={150}
          />
        </div>
        <h1 class="mb-4 text-5xl font-light font-serif text-[var(--color-text)]">
          Leisure Thoughts
        </h1>
        <p class="mx-auto mb-6 max-w-[34rem] text-[var(--color-text-secondary)]">
          Essays, notes, and a quieter personal corner. If you want the broader index of
          projects, tools, websites, and contributions, there is now a dedicated intro
          navigation site.
        </p>
        <p>
          <a
            href="https://intro.xihale.top"
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] px-5 py-2.5 text-sm text-[var(--color-text)] transition-colors duration-300 hover:bg-[var(--interactive-hover-bg)]"
          >
            Open xihale intro
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
