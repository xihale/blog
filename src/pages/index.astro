---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero" aria-label="种墨">
    <div class="hero-inner">
      <svg class="hero-emblem" viewBox="0 0 256 256" role="img" aria-label="墨滴中生长的小树">
        <mask id="heroInkMask" maskUnits="userSpaceOnUse">
          <rect width="256" height="256" fill="#fff" />
          <g fill="none" stroke="#000" stroke-linecap="round" stroke-linejoin="round">
            <path
              class="hero-ink-trunk"
              stroke-width="10"
              pathLength="100"
              d="M 126 252 C 126 200, 123 148, 136 92"
            />
            <path
              class="hero-ink-branch-l"
              stroke-width="7.5"
              pathLength="100"
              d="M 127 150 C 112 142, 97 135, 81 117"
            />
            <path
              class="hero-ink-branch-r"
              stroke-width="7"
              pathLength="100"
              d="M 129 131 C 144 121, 158 111, 168 100"
            />
          </g>
        </mask>
        <path
          class="hero-ink-body"
          fill="currentColor"
          mask="url(#heroInkMask)"
          d="M 128 20 C 132 20, 135 24, 137 29 C 156 76, 208 122, 208 168 C 208 214, 172 240, 128 240 C 84 240, 48 214, 48 168 C 48 122, 100 76, 119 29 C 121 24, 124 20, 128 20 Z"
        />
      </svg>

      <h1 class="sr-only">种墨</h1>
      <p class="hero-tagline">落墨成字，静待抽枝。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 11rem);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 4rem;
  }

  .hero-emblem {
    width: clamp(220px, 30vmin, 320px);
    height: auto;
    color: var(--color-text);
  }

  /* 大幅版抽枝动画：淡入 → 主干 → 左右枝 */
  .hero-ink-body {
    animation: hero-ink-fade 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-ink-trunk,
  .hero-ink-branch-l,
  .hero-ink-branch-r {
    stroke-dasharray: 100.5;
    stroke-dashoffset: 100.8;
    animation: hero-ink-grow 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-ink-trunk {
    animation-delay: 0.45s;
  }

  .hero-ink-branch-l {
    animation-delay: 1.1s;
    animation-duration: 0.55s;
  }

  .hero-ink-branch-r {
    animation-delay: 1.3s;
    animation-duration: 0.55s;
  }

  @keyframes hero-ink-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes hero-ink-grow {
    to { stroke-dashoffset: 0; }
  }

  .hero-tagline {
    margin-top: 2rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    letter-spacing: 0.08em;
    animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.9s both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ink-body,
    .hero-ink-trunk,
    .hero-ink-branch-l,
    .hero-ink-branch-r,
    .hero-tagline {
      animation: none !important;
    }

    .hero-ink-trunk,
    .hero-ink-branch-l,
    .hero-ink-branch-r {
      stroke-dashoffset: 0 !important;
    }
  }
</style>
