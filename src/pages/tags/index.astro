---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDateShort, formatDateISO } from "../../utils/date";
import "../../styles/components/article.css";

const [blogPosts, fragmentPosts] = await Promise.all([
  getCollection("blog", ({ data }) => {
    return data.draft !== true && data.unlisted !== true;
  }),
  getCollection("fragments", ({ data }) => {
    return data.draft !== true && data.unlisted !== true;
  }),
]);

const entries = [
  ...blogPosts.map((post) => ({ post, href: `/writing/${post.id}/` })),
  ...fragmentPosts.map((post) => ({ post, href: `/fragments/${post.id}/` })),
];

// Collect all tags and group posts by tag
const tagMap = new Map<string, typeof entries>();
for (const entry of entries) {
  for (const tag of entry.post.data.tags ?? []) {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push(entry);
  }
}

// Sort tags by post count descending
const tags = [...tagMap.entries()]
  .map(([tag, entries]) => ({
    tag,
    posts: entries.sort(
      (a, b) => b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf(),
    ),
  }))
  .sort((a, b) => b.posts.length - a.posts.length);
---

<BaseLayout title="标签" description="按标签归档的全部文章与碎语">
  <header class="page-header">
    <h1>标签</h1>

    <nav class="tag-directory" aria-label="标签索引">
      {
        tags.map(({ tag, posts }) => (
          <a href={`#tag-${tag}`} class="tag tag-dir-link">
            #{tag}
            <span class="tag-count">{posts.length}</span>
          </a>
        ))
      }
    </nav>
  </header>

  <div class="archive-list">
    {
      tags.map(({ tag, posts }) => (
        <section class="archive-group">
          <h2 id={`tag-${tag}`} class="archive-heading">
            #{tag}
            <span class="archive-heading-count">{posts.length}</span>
          </h2>
          <div class="archive-items">
            {posts.map(({ post, href }) => (
              <div class="post-card">
                <a href={href} class="block">
                  <div class="blog-post-item">
                    <time
                      datetime={formatDateISO(post.data.pubDate)}
                      class="blog-date"
                    >
                      {formatDateShort(post.data.pubDate)}
                    </time>

                    <div class="blog-content">
                      <div class="post-title-row">
                        <h3 class="post-title">{post.data.title}</h3>
                      </div>

                      {post.data.description && (
                        <p class="post-description">
                          {post.data.description}
                        </p>
                      )}
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
