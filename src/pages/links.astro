---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkGroupSection from "../components/LinkGroupSection.astro";
import { linkGroups } from "../data/links";

const title = "Links";
const description = "Interesting links and resources";
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-[68ch]">
    <h1 class="mb-4">Links</h1>

    <p class="mb-6 text-[var(--color-text-secondary)]">
      A curated collection of interesting websites, blogs, and resources from
      around the web.
    </p>

    {linkGroups.map((group) => <LinkGroupSection group={group} />)}
  </div>
</BaseLayout>
