---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkGroupSection from "../components/LinkGroupSection.astro";
import { linkGroups } from "../data/links";

const title = "友链";
const description = "朋友们的站点与日常阅读";
---

<BaseLayout title={title} description={description}>
  <header class="page-header">
    <h1>友链</h1>
  </header>

  <div>
    {linkGroups.map((group) => <LinkGroupSection group={group} />)}
  </div>
</BaseLayout>
